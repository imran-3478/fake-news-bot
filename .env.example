# Copy to .env and fill in. NEVER commit the real .env anywhere.

# Meta Page access token (Messenger Platform).
# Leave empty for local dry-run mode: replies are logged, not sent.
PAGE_ACCESS_TOKEN=

# Any secret string — paste the SAME value in the Meta app dashboard
# when you subscribe the webhook.
VERIFY_TOKEN=

# Google AI Studio API key — enables photo/screenshot/video AI analysis.
# Leave empty to run text+link checking only.
GEMINI_API_KEY=

# Gemini model used for media analysis.
GEMINI_MODEL=gemini-3.5-flash
